.env
!/.env.example

# Environment files
# Local overrides and any file that starts with .env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
env/
.venv/
backend/python/

# Virtualenv folders
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log

# Coverage
coverage/
htmlcov/

# Backup files
*~
*.bak
*.swp

# Database files
*.sqlite3
*.db

# Kubernetes / kubeconfig
.kube/

# Credentials and secrets
# Generic credential files
credentials.json
client_secret.json
secrets.json
service-account.json
*.service-account.json
google-services.json

# AWS, GCP, Azure
.aws/
.azure/

# SSH / private keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks

# NPM auth
.npmrc

# Misc
# Ignore Kubernetes config, local notebooks, and OneDrive temp files
~$*

# Ignore backend instance folder (Flask instance configs / secrets)
/backend/instance/
